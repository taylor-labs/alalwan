---
layout: layouts/base.njk
title: Shaykh Sulayman al-Alwan
---

<div class="hero">
  <h1>
    <span data-lang-en class="typewriter-text" data-typewriter-text="Shaykh Sulayman&#10;ibn Nasir al-Alwan"></span>
    <span data-lang-ar lang="ar" dir="rtl" class="ar-label typewriter-text" data-typewriter-text="الشيخ سليمان&#10;بن ناصر العلوان"></span>
  </h1>
  <p class="hero-sub">
    <span data-lang-en>Fatawa, lectures, and writings — in Arabic and English.</span>
    <span data-lang-ar lang="ar" dir="rtl" class="ar-label">الفتاوى والمحاضرات والكتابات — بالعربية والإنجليزية.</span>
  </p>
  <div class="search-container">
    <input type="search" id="search-input" data-placeholder-en="Search fatawa, sciences, biography…" data-placeholder-ar="ابحث في الفتاوى والعلوم والسيرة الذاتية…" placeholder="Search fatawa, sciences, biography…" autocomplete="off">
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<div class="browse-section">
  <p class="section-label"><span data-lang-en>Browse</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">تصفح</span></p>
  <div class="browse-grid">
    <a href="/fatawa/" class="browse-card">
      <span class="browse-card-label"><span data-lang-en>Rulings</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">أحكام</span></span>
      <span><span data-lang-en>Fatawa</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">الفتاوى</span></span>
    </a>
    <a href="/biography/" class="browse-card">
      <span class="browse-card-label"><span data-lang-en>Life</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">الحياة</span></span>
      <span><span data-lang-en>Biography</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">السيرة الذاتية</span></span>
    </a>
    <a href="/sciences/aqeedah/" class="browse-card">
      <span class="browse-card-label"><span data-lang-en>Science</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">علم</span></span>
      <span><span data-lang-en>Aqeedah</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">العقيدة</span></span>
    </a>
    <a href="/sciences/hadith/" class="browse-card">
      <span class="browse-card-label"><span data-lang-en>Science</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">علم</span></span>
      <span><span data-lang-en>Hadith</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">الحديث</span></span>
    </a>
  </div>
</div>

<div class="recent-section">
  <p class="section-label"><span data-lang-en>Recent Fatawa</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">أحدث الفتاوى</span></p>
  <ul class="entry-list">
    {% for fatwa in collections.fatawa | reverse | limit(5) %}
    <li><a href="{{ fatwa.url }}">
      {% if fatwa.data.title_ar %}<span data-lang-en>{{ fatwa.data.title }}</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">{{ fatwa.data.title_ar }}</span>{% else %}{{ fatwa.data.title }}{% endif %}
    </a></li>
    {% endfor %}
  </ul>
  <a href="/fatawa/" class="view-all"><span data-lang-en>View all fatawa →</span><span data-lang-ar lang="ar" dir="rtl" class="ar-label">عرض جميع الفتاوى ←</span></a>
</div>

<script>
(function () {
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var speed = 38;
  var startDelay = 300;

  function render(el, slice, done) {
    el.textContent = slice;
    if (!done) {
      var cursor = document.createElement('span');
      cursor.className = 'typewriter-cursor';
      el.appendChild(cursor);
    }
  }

  document.querySelectorAll('.typewriter-text').forEach(function (el) {
    var fullText = el.getAttribute('data-typewriter-text');
    if (reduceMotion) {
      render(el, fullText, true);
      return;
    }
    render(el, '', false);
    setTimeout(function () {
      var i = 0;
      var timer = setInterval(function () {
        i++;
        var done = i >= fullText.length;
        render(el, fullText.slice(0, i), done);
        if (done) clearInterval(timer);
      }, speed);
    }, startDelay);
  });
})();

(function () {
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  let index = null;

  input.addEventListener('input', function () {
    const q = this.value.trim().toLowerCase();
    results.innerHTML = '';
    if (!q) return;
    if (!index) {
      fetch('/search-index.json')
        .then(r => r.json())
        .then(data => { index = data; render(q); });
    } else {
      render(q);
    }
  });

  var resultTypeAr = { fatwa: 'فتوى', scholar: 'عالم', poem: 'قصيدة', book: 'كتاب', poet: 'شاعر' };

  function render(q) {
    var isAr = document.documentElement.getAttribute('data-lang') === 'ar';
    const hits = index.filter(item => item.title.toLowerCase().includes(q)).slice(0, 10);
    if (!hits.length) {
      results.innerHTML = '<p class="search-result">' + (isAr ? 'لا توجد نتائج.' : 'No results.') + '</p>';
      return;
    }
    results.innerHTML = hits.map(item =>
      `<a class="search-result" href="${item.url}"><span class="result-type">${isAr ? (resultTypeAr[item.type] || item.type) : item.type}</span>${item.title}</a>`
    ).join('');
  }
})();
</script>
